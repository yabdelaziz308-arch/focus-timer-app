{
  "name": "focus-timer-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "npx vite & sleep 2 && npx electron . --no-sandbox",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2",
    "recharts": "^2.12.3",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.1.4",
    "@vitejs/plugin-react": "^4.2.1"
  },
  "build": {
    "appId": "com.yasmina.focustimer",
    "productName": "FocusTimer",
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "directories": {
      "output": "dist-electron"
    }
  }
}
